# Copy this file to .streamlit/secrets.toml and fill in the real value.
# NEVER commit .streamlit/secrets.toml (it is already in .gitignore).
#
# On Streamlit Community Cloud, set this same key under
# App settings -> Secrets instead of committing a file at all.

N8N_WEBHOOK_URL = "https://YOUR-N8N-DOMAIN/webhook/YOUR-PRODUCTION-WEBHOOK"
